@CpApis.Api_HostAddress = http://localhost:5013
@access_token = REPLACE_WITH_BEARER_TOKEN

GET {{CpApis.Api_HostAddress}}/api/tickets/entries?clientCode=PCAP
Accept: application/json
Authorization: Bearer {{access_token}}

###

POST {{CpApis.Api_HostAddress}}/api/tickets/create
Content-Type: application/json

{
  "POD": "PR1",
  "Title": "Sample ticket",
  "Desc": "Sample ticket description",
  "CreatedBy": "user@technijian.com",
  "ClientCode": "PCAP",
  "AssignedUser": "user@technijian.com",
  "RoleTypeTxt": "Off-Shore Development"
}

